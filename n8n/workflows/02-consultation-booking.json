    {"parameters":{"httpMethod":"POST","path":"renovateai/consultation-booking","responseMode":"responseNode","options":{}},"id":"booking-webhook","name":"Booking Webhook","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1200,300],"webhookId":"renovateai-consultation-booking"},
    {"parameters":{"jsCode":"const payload = $input.item.json.body ?? $input.item.json;\nconst errors = [];\nif (!payload.name?.trim()) errors.push('name is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(payload.email ?? '')) errors.push('a valid email is required');\nconst startsAt = new Date(payload.startsAt);\nif (Number.isNaN(startsAt.valueOf()) || startsAt <= new Date()) errors.push('choose a future consultation time');\nif (errors.length) return [{json: {valid: false, errors}}];\nreturn [{json: {valid: true, name: payload.name.trim(), email: payload.email.trim().toLowerCase(), startsAt: startsAt.toISOString(), notes: String(payload.notes ?? '').trim()}}];"},"id":"validate-booking","name":"Validate Booking","type":"n8n-nodes-base.code","typeVersion":2,"position":[-960,300]},
