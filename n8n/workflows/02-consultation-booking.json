    {"parameters":{"jsCode":"const response = $input.item.json;\nconst body = typeof response.body === 'string' ? JSON.parse(response.body) : response.body;\nif (!body?.id) throw new Error('Google Calendar did not return an event id.');\nconst booking = $node['Prepare Calendar Event'].json;\nreturn [{json: {leadId: booking.lead.id, startsAt: booking.startsAt, endsAt: booking.endsAt, calendarEventId: body.id}}];"},"id":"prepare-consultation","name":"Prepare Consultation Record","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,180]},
