    {"parameters":{"jsCode":"const result = $input.item.json;\nconst body = typeof result.body === 'string' ? JSON.parse(result.body) : result.body;\nconst lead = Array.isArray(body) ? body[0] : null;\nif (!lead?.id) throw new Error('No matching lead found for this email.');\nconst booking = $node['Validate Booking'].json;\nconst start = new Date(booking.startsAt);\nconst end = new Date(start.valueOf() + 30 * 60 * 1000);\nreturn [{json: {lead, startsAt: start.toISOString(), endsAt: end.toISOString(), notes: booking.notes, calendarEvent: {summary: `RenovateAI consultation — ${lead.name}`, description: `Lead: ${lead.email}\\nProject: ${lead.project_type}\\nNotes: ${booking.notes}`, start: {dateTime: start.toISOString()}, end: {dateTime: end.toISOString()}, attendees: [{email: lead.email}]}}];"},"id":"prepare-event","name":"Prepare Calendar Event","type":"n8n-nodes-base.code","typeVersion":2,"position":[-240,180]},
