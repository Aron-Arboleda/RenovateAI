{
  "name": "03 Consultation Reminders",
  "nodes": [
    {"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":15}]}},"id":"reminder-schedule","name":"Every 15 Minutes","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-720,300]},
    {"parameters":{"jsCode":"const now = new Date();\nconst iso = (offsetMinutes) => new Date(now.valueOf() + offsetMinutes * 60000).toISOString();\nreturn [{json: {h24Start: iso(1430), h24End: iso(1450), h1Start: iso(50), h1End: iso(70)}}];"},"id":"reminder-windows","name":"Build Reminder Windows","type":"n8n-nodes-base.code","typeVersion":2,"position":[-480,300]},
    {"parameters":{"method":"GET","url":"={{ $env.SUPABASE_URL + '/rest/v1/consultations?select=id,lead_id,starts_at,leads(name,email,project_type)&status=eq.booked&or=(and(starts_at.gte.' + $json.h24Start + ',starts_at.lte.' + $json.h24End + ',reminder_24h_sent_at.is.null),and(starts_at.gte.' + $json.h1Start + ',starts_at.lte.' + $json.h1End + ',reminder_1h_sent_at.is.null))' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.SUPABASE_SECRET_KEY || $env.SUPABASE_SERVICE_ROLE_KEY }}"},{"name":"Authorization","value":"={{ 'Bearer ' + ($env.SUPABASE_SECRET_KEY || $env.SUPABASE_SERVICE_ROLE_KEY) }}"}]},"options":{"response":{"response":{"fullResponse":true}}}},"id":"find-reminders","name":"Find Due Reminders","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-240,300]},
    {"parameters":{"jsCode":"const response = $input.item.json;\nconst rows = typeof response.body === 'string' ? JSON.parse(response.body) : response.body;\nconst now = Date.now();\nreturn (Array.isArray(rows) ? rows : []).map((consultation) => {\n  const minutesAway = (new Date(consultation.starts_at).valueOf() - now) / 60000;\n  const reminderType = minutesAway > 12 * 60 ? '24-hour' : '1-hour';\n  const lead = consultation.leads;\n  return {json: {consultation, reminderType, subject: `Reminder: your consultation is in ${reminderType === '24-hour' ? '24 hours' : 'about 1 hour'}`, html: `<p>Hi ${lead.name},</p><p>This is a reminder that your RenovateAI consultation is scheduled for ${new Date(consultation.starts_at).toLocaleString()}.</p><p>We look forward to discussing your ${lead.project_type} project.</p>`}};\n});"},"id":"prepare-reminders","name":"Prepare Reminder Emails","type":"n8n-nodes-base.code","typeVersion":2,"position":[0,300]},
    {"parameters":{"method":"POST","url":"https://api.resend.com/emails","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"={{ 'Bearer ' + $env.RESEND_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ {from: $env.RESEND_FROM_EMAIL, to: [$json.consultation.leads.email], subject: $json.subject, html: $json.html} }}","options":{"response":{"response":{"fullResponse":true,"neverError":true}}}},"id":"send-reminder","name":"Send Reminder Email","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[240,300]},
    {"parameters":{"method":"PATCH","url":"={{ $env.SUPABASE_URL + '/rest/v1/consultations?id=eq.' + $node['Prepare Reminder Emails'].json.consultation.id }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.SUPABASE_SECRET_KEY || $env.SUPABASE_SERVICE_ROLE_KEY }}"},{"name":"Authorization","value":"={{ 'Bearer ' + ($env.SUPABASE_SECRET_KEY || $env.SUPABASE_SERVICE_ROLE_KEY) }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ $node['Prepare Reminder Emails'].json.reminderType === '24-hour' ? {reminder_24h_sent_at: new Date().toISOString()} : {reminder_1h_sent_at: new Date().toISOString()} }}"},"id":"mark-reminder","name":"Mark Reminder Sent","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[480,300]}
  ],
  "connections":{"Every 15 Minutes":{"main":[[{"node":"Build Reminder Windows","type":"main","index":0}]]},"Build Reminder Windows":{"main":[[{"node":"Find Due Reminders","type":"main","index":0}]]},"Find Due Reminders":{"main":[[{"node":"Prepare Reminder Emails","type":"main","index":0}]]},"Prepare Reminder Emails":{"main":[[{"node":"Send Reminder Email","type":"main","index":0}]]},"Send Reminder Email":{"main":[[{"node":"Mark Reminder Sent","type":"main","index":0}]]}},
  "active":false,
  "settings":{"executionOrder":"v1"}
}
