{
  "name": "01 Lead Intake MVP",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "renovateai/lead-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d7d5282c-699e-4d7a-a0a9-26357f574a98",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [260, 300],
      "webhookId": "cc88bdb8-e7cd-4a1f-99dd-e685fd49f10b"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json;\nconst requiredFields = [\n  \"name\",\n  \"email\",\n  \"phone\",\n  \"projectType\",\n  \"budget\",\n  \"location\",\n  \"timeline\",\n  \"description\",\n];\n\nconst errors = [];\n\nfor (const field of requiredFields) {\n  const value = payload[field];\n  if (typeof value !== \"string\" || !value.trim()) {\n    errors.push(`${field} is required`);\n  }\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (typeof payload.email !== \"string\" || !emailRegex.test(payload.email.trim())) {\n  errors.push(\"email must be valid\");\n}\n\nreturn [\n  {\n    json: {\n      ...payload,\n      isValid: errors.length === 0,\n      validationErrors: errors,\n    },\n  },\n];"
      },
      "id": "915d1a8d-5083-40f5-b7cf-f06ca2900f17",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValid }}",
              "operation": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "2f49248c-5663-4cbf-82ec-c5009af5f468",
      "name": "Is Valid Payload?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"message\": \"Lead payload accepted\", \"received\": { \"name\": $json.name, \"email\": $json.email, \"phone\": $json.phone, \"projectType\": $json.projectType, \"budget\": $json.budget, \"location\": $json.location, \"timeline\": $json.timeline, \"description\": $json.description } } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "cfed1073-9256-4bc8-af56-faf0dcbb4aa3",
      "name": "Respond Valid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1020, 220]
    },
    {
